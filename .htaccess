# Directory listings must never be served. This lives at top level on
# purpose: the -Indexes below is nested inside <IfModule mod_negotiation.c>,
# so on a server without that module it silently did nothing and /backups/
# and /storage/logs/ were listable.
Options -Indexes

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # LinkStack serves from the app root (shared-hosting layout), so the
    # framework's own directories sit inside the document root. The front
    # controller below only runs for paths that DON'T resolve to a real
    # file, which means Apache serves anything that does exist straight
    # off disk — including things the app itself writes there:
    #
    #   storage/framework/sessions/<id>  session payloads, unencrypted,
    #                                    filename == the session id
    #   storage/logs/laravel.log         stack traces, SQL, user emails
    #   backups/env_<timestamp>          verbatim copies of .env
    #
    # This used to be a deny-list naming those directories, which is
    # fail-open: anything the list didn't name was public. It missed
    # blocks/*/display.blade.php (raw Blade source — the contact-form
    # template names the honeypot field, so serving it tells a spammer
    # which input to leave blank), docker/entrypoint.sh, theme-toolkit/,
    # and every root-level file from artisan to composer.lock. An upstream
    # merge or a new backup routine would have kept adding to that list
    # silently.
    #
    # So it is an allowlist now: if a request resolves to a real file and
    # isn't named below, it is refused. Only these are ever fetched off
    # disk —
    #
    #   index.php                       front controller
    #   assets/                         450+ view refs; assets/img is the
    #                                   symlink to the /data volume
    #   themes/                         per-page theme css
    #   resources/ckeditor/             admin: panel/pages, panel/site
    #   vendor/livewire/livewire/dist/  admin: panel/users
    #
    # blocks/ is deliberately absent: block_asset() returns
    # url("block-asset/$type?asset=$file"), a route that reads the file
    # with file_get_contents(), so Apache never needs to reach blocks/.
    #
    # The -f guard means missing paths still fall through to the front
    # controller, so routing is untouched. Directories are handled by the
    # top-level Options -Indexes. The pattern matches relative to this
    # directory, so subdirectory installs are covered too.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule !^(index\.php$|assets/|themes/|resources/ckeditor/|vendor/livewire/livewire/dist/) - [F,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Restrict access to critical files
<FilesMatch "^\.">
Order allow,deny
Deny from all
</FilesMatch>
<Files ~ "\.sqlite$">
    Order allow,deny
    Deny from all
</Files>
<Files ~ "\.zip$">
    Order allow,deny
    Deny from all
</Files>
# Second layer for the log file, independent of mod_rewrite: if
# mod_rewrite is ever absent the RewriteRule denials above vanish, and
# storage/logs/laravel.log is the highest-value readable file left.
<Files ~ "\.log$">
    Order allow,deny
    Deny from all
</Files>