/assets/favicon/icons
/node_modules
/public/hot
/public/storage
/storage/*.key

# Installer state markers. These MUST never be tracked: routes/web.php
# registers the unauthenticated installer (including /skip, which seeds a
# well-known admin and logs the caller in) while either is present, so a
# tracked marker means every fresh clone ships an open admin backdoor.
/INSTALLING
/INSTALLERLOCK
/vendor
.env
.env.backup
.env.*
!.env.example
.phpunit.result.cache

# Local dev SQLite DB — was tracked historically; now untracked so the
# working copy (which fills with real test data) can never be committed
# or pushed to the public fork. Ship migrations, not the DB.
/database/database.sqlite
*.sqlite
docker-compose.override.yml
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log
_ide_*

# Claude Code working directory. Holds git worktrees, and those worktrees
# carry their own .env — i.e. a full copy of the live secrets. This repo is
# public, so a stray `git add -A` here would publish them.
/.claude

# Internal reference docs — kept locally, not published to the public
# AGPL source repo (plans, kickoff prompts, pre-deploy audit).
/CUSTOM-FEATURES.md
/LANDING-PAGE-PROMPT.md
/PRE-DEPLOY-AUDIT.md
/STUDIO-EDITOR-PROMPT.md
/THEME-APPEARANCE-PLAN.md
/THEME-LIBRARY-PROMPT.md
/UI-IMPROVEMENTS.md
/UI-PASS-PLAN.md
/CSP-HARDENING-PLAN.md
/DRAFT-PUBLISH-PLAN.md
/SECURITY-ASSESSMENT.md
